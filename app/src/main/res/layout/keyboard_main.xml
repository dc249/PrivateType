<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#1B1B1B"
    android:padding="2dp">

    <ViewFlipper
        android:id="@+id/keyboard_flipper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- PAGE 0: QWERTY -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                <Button android:id="@+id/key_q" android:layout_width="0dp" android:layout_weight="1" android:layout_height="60dp" android:layout_margin="2dp" android:text="q" android:textAllCaps="false" android:backgroundTint="#424242" />
                <Button android:id="@+id/key_w" android:layout_width="0dp" android:layout_weight="1" android:layout_height="60dp" android:layout_margin="2dp" android:text="w" android:textAllCaps="false" android:backgroundTint="#424242" />
                <Button android:id="@+id/key_e" android:layout_width="0dp" android:layout_weight="1" android:layout_height="60dp" android:layout_margin="2dp" android:text="e" android:textAllCaps="false" android:backgroundTint="#424242" />
                <Button android:id="@+id/key_r" android:layout_width="0dp" android:layout_weight="1" android:layout_height="60dp" android:layout_margin="2dp" android:text="r" android:textAllCaps="false" android:backgroundTint="#424242" />
                <Button android:id="@+id/key_t" android:layout_width="0dp" android:layout_weight="1" android:layout_height="60dp" android:layout_margin="2dp" android:text="t" android:textAllCaps="false" android:backgroundTint="#424242" />
                <Button android:id="@+id/key_y" android:layout_width="0dp" android:layout_weight="1" android:layout_height="60dp" android:layout_margin="2dp" android:text="y" android:textAllCaps="false" android:backgroundTint="#424242" />
                <Button android:id="@+id/key_u" android:layout_width="0dp" android:layout_weight="1" android:layout_height="60dp" android:layout_margin="2dp" android:text="u" android:textAllCaps="false" android:backgroundTint="#424242" />
                <Button android:id="@+id/key_i" android:layout_width="0dp" android:layout_weight="1" android:layout_height="60dp" android:layout_margin="2dp" android:text="i" android:textAllCaps="false" android:backgroundTint="#424242" />
                <Button android:id="@+id/key_o" android:layout_width="0dp" android:layout_weight="1" android:layout_height="60dp" android:layout_margin="2dp" android:text="o" android:textAllCaps="false" android:backgroundTint="#424242" />
                <Button android:id="@+id/key_p" android:layout_width="0dp" android:layout_weight="1" android:layout_height="60dp" android:layout_margin="2dp" android:text="p" android:textAllCaps="false" android:backgroundTint="#424242" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="10dp" android:paddingEnd="10dp">
                <Button android:id="@+id/key_a" android:layout_width="0dp" android:layout_weight="1" android:layout_height="60dp" android:layout_margin="2dp" android:text="a" android:textAllCaps="false" android:backgroundTint="#424242" />
                <Button android:id="@+id/key_s" android:layout_width="0dp" android:layout_weight="1" android:layout_height="60dp" android:layout_margin="2dp" android:text="s" android:textAllCaps="false" android:backgroundTint="#424242" />
                <Button android:id="@+id/key_d" android:layout_width="0dp" android:layout_weight="1" android:layout_height="60dp" android:layout_margin="2dp" android:text="d" android:textAllCaps="false" android:backgroundTint="#424242" />
                <Button android:id="@+id/key_f" android:layout_width="0dp" android:layout_weight="1" android:layout_height="60dp" android:layout_margin="2dp" android:text="f" android:textAllCaps="false" android:backgroundTint="#424242" />
                <Button android:id="@+id/key_g" android:layout_width="0dp" android:layout_weight="1" android:layout_height="60dp" android:layout_margin="2dp" android:text="g" android:textAllCaps="false" android:backgroundTint="#424242" />
                <Button android:id="@+id/key_h" android:layout_width="0dp" android:layout_weight="1" android:layout_height="60dp" android:layout_margin="2dp" android:text="h" android:textAllCaps="false" android:backgroundTint="#424242" />
                <Button android:id="@+id/key_j" android:layout_width="0dp" android:layout_weight="1" android:layout_height="60dp" android:layout_margin="2dp" android:text="j" android:textAllCaps="false" android:backgroundTint="#424242" />
                <Button android:id="@+id/key_k" android:layout_width="0dp" android:layout_weight="1" android:layout_height="60dp" android:layout_margin="2dp" android:text="k" android:textAllCaps="false" android:backgroundTint="#424242" />
                <Button android:id="@+id/key_l" android:layout_width="0dp" android:layout_weight="1" android:layout_height="60dp" android:layout_margin="2dp" android:text="l" android:textAllCaps="false" android:backgroundTint="#424242" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                <Button android:id="@+id/key_shift" android:layout_width="0dp" android:layout_weight="1.5" android:layout_height="60dp" android:layout_margin="2dp" android:text="⇧" android:backgroundTint="#424242" />
                <Button android:id="@+id/key_z" android:layout_width="0dp" android:layout_weight="1" android:layout_height="60dp" android:layout_margin="2dp" android:text="z" android:textAllCaps="false" android:backgroundTint="#424242" />
                <Button android:id="@+id/key_x" android:layout_width="0dp" android:layout_weight="1" android:layout_height="60dp" android:layout_margin="2dp" android:text="x" android:textAllCaps="false" android:backgroundTint="#424242" />
                <Button android:id="@+id/key_c" android:layout_width="0dp" android:layout_weight="1" android:layout_height="60dp" android:layout_margin="2dp" android:text="c" android:textAllCaps="false" android:backgroundTint="#424242" />
                <Button android:id="@+id/key_v" android:layout_width="0dp" android:layout_weight="1" android:layout_height="60dp" android:layout_margin="2dp" android:text="v" android:textAllCaps="false" android:backgroundTint="#424242" />
                <Button android:id="@+id/key_b" android:layout_width="0dp" android:layout_weight="1" android:layout_height="60dp" android:layout_margin="2dp" android:text="b" android:textAllCaps="false" android:backgroundTint="#424242" />
                <Button android:id="@+id/key_n" android:layout_width="0dp" android:layout_weight="1" android:layout_height="60dp" android:layout_margin="2dp" android:text="n" android:textAllCaps="false" android:backgroundTint="#424242" />
                <Button android:id="@+id/key_m" android:layout_width="0dp" android:layout_weight="1" android:layout_height="60dp" android:layout_margin="2dp" android:text="m" android:textAllCaps="false" android:backgroundTint="#424242" />
                <Button android:id="@+id/key_backspace" android:layout_width="0dp" android:layout_weight="1.5" android:layout_height="60dp" android:layout_margin="2dp" android:text="⌫" android:backgroundTint="#424242" />
            </LinearLayout>
        </LinearLayout>

        <!-- PAGE 1: SYMBOLS -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                <Button android:id="@+id/sym_1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="60dp" android:layout_margin="2dp" android:text="1" android:backgroundTint="#424242" />
                <Button android:id="@+id/sym_2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="60dp" android:layout_margin="2dp" android:text="2" android:backgroundTint="#424242" />
                <Button android:id="@+id/sym_3" android:layout_width="0dp" android:layout_weight="1" android:layout_height="60dp" android:layout_margin="2dp" android:text="3" android:backgroundTint="#424242" />
                <Button android:id="@+id/sym_4" android:layout_width="0dp" android:layout_weight="1" android:layout_height="60dp" android:layout_margin="2dp" android:text="4" android:backgroundTint="#424242" />
                <Button android:id="@+id/sym_5" android:layout_width="0dp" android:layout_weight="1" android:layout_height="60dp" android:layout_margin="2dp" android:text="5" android:backgroundTint="#424242" />
                <Button android:id="@+id/sym_6" android:layout_width="0dp" android:layout_weight="1" android:layout_height="60dp" android:layout_margin="2dp" android:text="6" android:backgroundTint="#424242" />
                <Button android:id="@+id/sym_7" android:layout_width="0dp" android:layout_weight="1" android:layout_height="60dp" android:layout_margin="2dp" android:text="7" android:backgroundTint="#424242" />
                <Button android:id="@+id/sym_8" android:layout_width="0dp" android:layout_weight="1" android:layout_height="60dp" android:layout_margin="2dp" android:text="8" android:backgroundTint="#424242" />
                <Button android:id="@+id/sym_9" android:layout_width="0dp" android:layout_weight="1" android:layout_height="60dp" android:layout_margin="2dp" android:text="9" android:backgroundTint="#424242" />
                <Button android:id="@+id/sym_0" android:layout_width="0dp" android:layout_weight="1" android:layout_height="60dp" android:layout_margin="2dp" android:text="0" android:backgroundTint="#424242" />
            </LinearLayout>
            <!-- Add more symbol rows as needed following this pattern -->
        </LinearLayout>
    </ViewFlipper>

    <!-- PERSISTENT BOTTOM ROW -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
        <Button android:id="@+id/key_mode_toggle" android:layout_width="0dp" android:layout_weight="2" android:layout_height="60dp" android:layout_margin="2dp" android:text="?123" android:backgroundTint="#2D2D2D" />
        <Button android:id="@+id/key_gif" android:layout_width="0dp" android:layout_weight="2" android:layout_height="60dp" android:layout_margin="2dp" android:text="GIF" android:backgroundTint="#2D2D2D" />
        <Button android:id="@+id/key_space" android:layout_width="0dp" android:layout_weight="5" android:layout_height="60dp" android:layout_margin="2dp" android:text=" " android:backgroundTint="#424242" />
        <Button android:id="@+id/key_enter" android:layout_width="0dp" android:layout_weight="2" android:layout_height="60dp" android:layout_margin="2dp" android:text="Enter" android:backgroundTint="#2D2D2D" />
    </LinearLayout>

</LinearLayout>
