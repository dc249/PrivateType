<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#1B1B1B"
    android:padding="4dp">

    <ViewFlipper
        android:id="@+id/keyboard_flipper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- PAGE 0: QWERTY -->
        <include layout="@layout/layout_qwerty" />

        <!-- PAGE 1: SYMBOLS -->
        <include layout="@layout/layout_symbols" />

    </ViewFlipper>

    <!-- Bottom Row (Persistent for both pages) -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <Button android:id="@+id/key_mode_toggle" android:layout_width="0dp" android:layout_height="60dp" android:layout_weight="1.5" android:layout_margin="2dp" android:text="?123" android:backgroundTint="#424242" android:textColor="#FFFFFF" />
        <Button android:id="@+id/key_gif" android:layout_width="0dp" android:layout_height="60dp" android:layout_weight="1.5" android:layout_margin="2dp" android:text="GIF" android:backgroundTint="#424242" android:textColor="#FFFFFF" />
        <Button android:id="@+id/key_space" android:layout_width="0dp" android:layout_height="60dp" android:layout_weight="5" android:layout_margin="2dp" android:text=" " android:backgroundTint="#424242" android:textColor="#FFFFFF" />
        <Button android:id="@+id/key_enter" android:layout_width="0dp" android:layout_height="60dp" android:layout_weight="2" android:layout_margin="2dp" android:text="Enter" android:backgroundTint="#424242" android:textColor="#FFFFFF" />
    </LinearLayout>
</LinearLayout>
