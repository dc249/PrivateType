<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#131314"
    android:padding="2dp">

    <!-- Row 1 -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:id="@+id/key_q" style="@style/KeyStyle" android:layout_width="0dp" android:layout_weight="1" android:text="q" />
        <TextView android:id="@+id/key_w" style="@style/KeyStyle" android:layout_width="0dp" android:layout_weight="1" android:text="w" />
        <TextView android:id="@+id/key_e" style="@style/KeyStyle" android:layout_width="0dp" android:layout_weight="1" android:text="e" />
        <TextView android:id="@+id/key_r" style="@style/KeyStyle" android:layout_width="0dp" android:layout_weight="1" android:text="r" />
        <TextView android:id="@+id/key_t" style="@style/KeyStyle" android:layout_width="0dp" android:layout_weight="1" android:text="t" />
        <TextView android:id="@+id/key_y" style="@style/KeyStyle" android:layout_width="0dp" android:layout_weight="1" android:text="y" />
        <TextView android:id="@+id/key_u" style="@style/KeyStyle" android:layout_width="0dp" android:layout_weight="1" android:text="u" />
        <TextView android:id="@+id/key_i" style="@style/KeyStyle" android:layout_width="0dp" android:layout_weight="1" android:text="i" />
        <TextView android:id="@+id/key_o" style="@style/KeyStyle" android:layout_width="0dp" android:layout_weight="1" android:text="o" />
        <TextView android:id="@+id/key_p" style="@style/KeyStyle" android:layout_width="0dp" android:layout_weight="1" android:text="p" />
    </LinearLayout>

    <!-- Bottom Row with Spacebar and Period -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:id="@+id/key_mode_toggle" style="@style/KeyStyle" android:layout_width="0dp" android:layout_weight="1.5" android:text="@string/label_symbols" />
        <TextView android:id="@+id/key_space" style="@style/KeyStyle" android:layout_width="0dp" android:layout_weight="5" android:text=" " />
        <TextView android:id="@+id/key_period" style="@style/KeyStyle" android:layout_width="0dp" android:layout_weight="1.2" android:text="." />
        <TextView android:id="@+id/key_enter" style="@style/KeyStyle" android:layout_width="0dp" android:layout_weight="1.6" android:text="⏎" android:backgroundTint="#3D5AFE" />
    </LinearLayout>

</LinearLayout>
