<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#131314"
    android:padding="2dp">

    <!-- Row 1 -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:id="@+id/key_q" style="@style/KeyStyle" android:layout_width="0dp" android:layout_weight="1" android:text="q" />
        <TextView android:id="@+id/key_w" style="@style/KeyStyle" android:layout_width="0dp" android:layout_weight="1" android:text="w" />
        <TextView android:id="@+id/key_e" style="@style/KeyStyle" android:layout_width="0dp" android:layout_weight="1" android:text="e" />
        <TextView android:id="@+id/key_r" style="@style/KeyStyle" android:layout_width="0dp" android:layout_weight="1" android:text="r" />
        <TextView android:id="@+id/key_t" style="@style/KeyStyle" android:layout_width="0dp" android:layout_weight="1" android:text="t" />
        <TextView android:id="@+id/key_y" style="@style/KeyStyle" android:layout_width="0dp" android:layout_weight="1" android:text="y" />
        <TextView android:id="@+id/key_u" style="@style/KeyStyle" android:layout_width="0dp" android:layout_weight="1" android:text="u" />
        <TextView android:id="@+id/key_i" style="@style/KeyStyle" android:layout_width="0dp" android:layout_weight="1" android:text="i" />
        <TextView android:id="@+id/key_o" style="@style/KeyStyle" android:layout_width="0dp" android:layout_weight="1" android:text="o" />
        <TextView android:id="@+id/key_p" style="@style/KeyStyle" android:layout_width="0dp" android:layout_weight="1" android:text="p" />
    </LinearLayout>

    <!-- Row 2 -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingStart="15dp" android:paddingEnd="15dp">
        <TextView android:id="@+id/key_a" style="@style/KeyStyle" android:layout_width="0dp" android:layout_weight="1" android:text="a" />
        <TextView android:id="@+id/key_s" style="@style/KeyStyle" android:layout_width="0dp" android:layout_weight="1" android:text="s" />
        <TextView android:id="@+id/key_d" style="@style/KeyStyle" android:layout_width="0dp" android:layout_weight="1" android:text="d" />
        <TextView android:id="@+id/key_f" style="@style/KeyStyle" android:layout_width="0dp" android:layout_weight="1" android:text="f" />
        <TextView android:id="@+id/key_g" style="@style/KeyStyle" android:layout_width="0dp" android:layout_weight="1" android:text="g" />
        <TextView android:id="@+id/key_h" style="@style/KeyStyle" android:layout_width="0dp" android:layout_weight="1" android:text="h" />
        <TextView android:id="@+id/key_j" style="@style/KeyStyle" android:layout_width="0dp" android:layout_weight="1" android:text="j" />
        <TextView android:id="@+id/key_k" style="@style/KeyStyle" android:layout_width="0dp" android:layout_weight="1" android:text="k" />
        <TextView android:id="@+id/key_l" style="@style/KeyStyle" android:layout_width="0dp" android:layout_weight="1" android:text="l" />
    </LinearLayout>

    <!-- Row 3 -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:id="@+id/key_shift" style="@style/KeyStyle" android:layout_width="0dp" android:layout_weight="1.5" android:text="⇧" />
        <TextView android:id="@+id/key_z" style="@style/KeyStyle" android:layout_width="0dp" android:layout_weight="1" android:text="z" />
        <TextView android:id="@+id/key_x" style="@style/KeyStyle" android:layout_width="0dp" android:layout_weight="1" android:text="x" />
        <TextView android:id="@+id/key_c" style="@style/KeyStyle" android:layout_width="0dp" android:layout_weight="1" android:text="c" />
        <TextView android:id="@+id/key_v" style="@style/KeyStyle" android:layout_width="0dp" android:layout_weight="1" android:text="v" />
        <TextView android:id="@+id/key_b" style="@style/KeyStyle" android:layout_width="0dp" android:layout_weight="1" android:text="b" />
        <TextView android:id="@+id/key_n" style="@style/KeyStyle" android:layout_width="0dp" android:layout_weight="1" android:text="n" />
        <TextView android:id="@+id/key_m" style="@style/KeyStyle" android:layout_width="0dp" android:layout_weight="1" android:text="m" />
        <TextView android:id="@+id/key_backspace" style="@style/KeyStyle" android:layout_width="0dp" android:layout_weight="1.5" android:text="⌫" />
    </LinearLayout>

    <!-- Row 4 -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:id="@+id/key_mode_toggle" style="@style/KeyStyle" android:layout_width="0dp" android:layout_weight="1.5" android:text="@string/label_symbols" />
        <TextView android:id="@+id/key_gif" style="@style/KeyStyle" android:layout_width="0dp" android:layout_weight="1.2" android:text="GIF" />
        <TextView android:id="@+id/key_space" style="@style/KeyStyle" android:layout_width="0dp" android:layout_weight="4.5" android:text=" " />
        <TextView android:id="@+id/key_period" style="@style/KeyStyle" android:layout_width="0dp" android:layout_weight="1.2" android:text="." />
        <TextView android:id="@+id/key_enter" style="@style/KeyStyle" android:layout_width="0dp" android:layout_weight="1.6" android:text="⏎" android:backgroundTint="#3D5AFE"/>
    </LinearLayout>
</LinearLayout>
