<LinearLayout ... android:background="#131314">
    <!-- Row 1-3 (Standard QWERTY) -->
    
    <!-- Row 4: Responsive Bottom Row -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:id="@+id/key_mode_toggle" style="@style/KeyStyle" 
            android:layout_width="0dp" android:layout_weight="1.5" android:text="?123" />
        
        <TextView android:id="@+id/key_gif" style="@style/KeyStyle" 
            android:layout_width="0dp" android:layout_weight="1.2" android:text="GIF" />

        <TextView android:id="@+id/key_space" style="@style/KeyStyle" 
            android:layout_width="0dp" android:layout_weight="4.5" android:text=" " />

        <TextView android:id="@+id/key_period" style="@style/KeyStyle" 
            android:layout_width="0dp" android:layout_weight="1.2" android:text="." />

        <TextView android:id="@+id/key_enter" style="@style/KeyStyle" 
            android:layout_width="0dp" android:layout_weight="1.6" android:text="⏎" 
            android:backgroundTint="#3D5AFE"/>
    </LinearLayout>
</LinearLayout>
